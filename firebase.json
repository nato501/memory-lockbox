{
  "firestore": {
    "database": "(default)",
    "location": "asia-southeast1",
    "rules": "public/firestore.rules",
    "indexes": "public/firestore.indexes.json"
  },
  "hosting": {
    "site": "dodo-aa50f",
    "public": "frontend",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
